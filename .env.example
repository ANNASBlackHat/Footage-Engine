# ==============================================================================
# Footage Retrieval Engine — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Stock Provider API Keys (For keyword search ingestion)
# ------------------------------------------------------------------------------
# Get free Pexels key: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# Get free Pixabay key: https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Get Coverr key: https://coverr.co/
COVERR_API_KEY=

# YouTube Cookies (Optional: local file path, direct download URL, or raw Netscape/base64 string)
# YOUTUBE_COOKIES=/path/to/cookies.txt
# YOUTUBE_COOKIES=https://my-bucket/cookies.txt

# Or extract cookies directly from your installed browser session:
# YOUTUBE_COOKIES_FROM_BROWSER=chrome  # chrome, firefox, brave, safari, edge


# ------------------------------------------------------------------------------
# 2. Relational Database
# ------------------------------------------------------------------------------
# SQLite (default, zero setup needed)
# DATABASE_URL=sqlite:///./footage_engine.db

# Or PostgreSQL (production):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/footage_engine

# ------------------------------------------------------------------------------
# 3. Raw Footage Storage Backend ('local', 'imagekit' or 'cloudinary')
# ------------------------------------------------------------------------------
# Set to 'true' if you want every video uploaded to your own cloud storage.
# Set to 'false' (default) to stream directly from Pixabay/Pexels without uploading.
UPLOAD_RAW_TO_STORAGE=false

# Set to 'true' if you want each detected scene chunk sliced into standalone .mp4 sub-clips and uploaded to storage.
# Set to 'false' (default) to keep the master video and store timestamp ranges in DB.
UPLOAD_CHUNKS_TO_STORAGE=false


STORAGE_BACKEND=imagekit
LOCAL_STORAGE_DIR=./data/storage

# If using ImageKit (managed cloud storage):
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# If using Cloudinary (managed cloud storage):
# Requires the optional dependency: pip install "footage-engine[cloudinary]"
# NOTE: the non-chunked upload endpoint rejects files over 100 MB (HTTP 413);
# larger payloads are automatically routed through chunked upload_large.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=footage_engine/raw

# If using Google Drive (managed cloud storage):
# Requires the optional dependency: pip install "footage-engine[gdrive]"
# Configure EXACTLY ONE credential identity. The two are not interchangeable:
# a service account gets storageQuota.limit == 0 and Drive rejects its uploads
# to an ordinary folder with "403 Service Accounts do not have storage quota",
# so it only works against a Shared Drive. User OAuth uploads as the consenting
# user, so the files are owned by them and consume their quota.
#
# (a) User OAuth — the only option that can write to a personal Drive folder.
# Mint a token with: python scripts/gdrive_oauth_login.py
# Then set exactly one of:
GDRIVE_OAUTH_CREDENTIALS_FILE=
# GDRIVE_OAUTH_CREDENTIALS_JSON={"type":"authorized_user","client_id":"...","client_secret":"...","refresh_token":"..."}
#
# (b) Service account — headless, Shared Drives only. Share the target folder
# with the key's client_email (or add the account to a Shared Drive), then set
# exactly one of:
# GDRIVE_SERVICE_ACCOUNT_FILE=
# GDRIVE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"..."}
#
# Destination: a folder the identity can write to, and/or a Shared Drive id.
GDRIVE_FOLDER_ID=
GDRIVE_DRIVE_ID=
# Default scope is the full 'drive' scope: 'drive.file' cannot see files that
# were shared *to* the identity, which breaks exists()/reads. A user OAuth
# refresh token is bound to the scopes granted at consent — if you change this,
# re-run the consent flow or reads start failing.
# GDRIVE_SCOPES=https://www.googleapis.com/auth/drive
# Public delivery link template ({file_id} is substituted). Switch to
# https://lh3.googleusercontent.com/d/{file_id} if large files show an
# interstitial when played back.
# GDRIVE_URL_TEMPLATE=https://drive.google.com/uc?export=download&id={file_id}

VECTOR_STORE=

# ------------------------------------------------------------------------------
# 4. Vector Database (Zilliz Cloud / Managed Milvus)
# ------------------------------------------------------------------------------
# If left empty, uses fast in-memory vector store automatically.
# Free Zilliz cluster: https://cloud.zilliz.com
ZILLIZ_URI=
ZILLIZ_TOKEN=
ZILLIZ_COLLECTION_NAME=

# Dedicated Qwen vector cluster (falls back to base ZILLIZ_* when empty).
# Needed because Qwen (2048d) cannot share the X-CLIP (512d) collection.
QWEN_ZILLIZ_URI=
QWEN_ZILLIZ_TOKEN=
QWEN_ZILLIZ_COLLECTION_NAME=

# ------------------------------------------------------------------------------
# 5. Embedding Model & Hardware Acceleration
# ------------------------------------------------------------------------------
DEFAULT_EMBEDDING_MODEL=microsoft/xclip-base-patch32
DEFAULT_EMBEDDING_VERSION=1.0
EMBEDDING_DIMENSION=512
# 'auto' automatically selects cuda:0 (Colab/NVIDIA), mps (Apple Silicon), or cpu
EMBEDDING_DEVICE=auto

# Number of chunks to forward pass through GPU in a single batch (default 8, set to 16 on Colab GPU)
EMBEDDING_BATCH_SIZE=8

# Parallel worker threads for downloading & chunking videos (default 2 on laptop, set to 4 on Colab)
NUM_WORKERS=2


# ------------------------------------------------------------------------------
# 6. Chunking Thresholds
# ------------------------------------------------------------------------------
CHUNK_THRESHOLD_SEC=45.0
SLIDING_WINDOW_SEC=10.0
SLIDING_OVERLAP_RATIO=0.5

# ------------------------------------------------------------------------------
# 7. Keyword Ingestion Defaults (Orientation & Media Type)
# ------------------------------------------------------------------------------
# Asset orientation: 'landscape' (horizontal / 16:9), 'portrait' (vertical / 9:16), or 'all'
# Defaults to 'landscape' for standard/long-form video creation.
ORIENTATION=landscape
# ASSET_ORIENTATION=landscape

# Media type to search & ingest: 'video' (default) or 'image'
MEDIA_TYPE=video

# Max results per provider per keyword
MAX_RESULTS_PER_KEYWORD=2

# ------------------------------------------------------------------------------
# 8. LLM / Multi-Query Expansion & Reranker (OpenAI-compatible / Gemini)
# ------------------------------------------------------------------------------
# Set GEMINI_API_KEY (or LLM_API_KEY / OPENAI_API_KEY) to enable Multi-Query expansion
# and optional LLM Judge reranker for script beats.
# Default base URL uses Google's OpenAI-compatible Gemini API endpoint:
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=your_gemini_api_key_here
# LLM_API_KEY=



# ------------------------------------------------------------------------------
# 9. Async Job Worker (queue-driven footage search)
# ------------------------------------------------------------------------------
# A caller submits a footage-search request as a row in the `jobs` table and a
# worker holding the embedding model executes it. Safe to run several workers
# (laptop + Colab + Kaggle) against the same database: claiming is atomic and
# every claim carries a lease.

# How long a claimed job stays owned before another worker may reclaim it.
# Must exceed the longest single job (fine_localize_clip on a long chunk).
WORKER_LEASE_SEC=900

# Lease renewal / worker liveness interval. Callers can check liveness with
# `SELECT count(*) FROM workers WHERE last_heartbeat > now() - interval '10 seconds'`.
WORKER_HEARTBEAT_SEC=30

# Sleep between empty-queue polls.
WORKER_POLL_INTERVAL_SEC=5

# 0 = run forever; >0 = exit after N idle seconds (recommended for Colab/Kaggle).
WORKER_IDLE_EXIT_SEC=0

# Jobs processed in parallel by one worker process.
WORKER_CONCURRENCY=1

# Optional comma-separated task allowlist, e.g. search_footage,fine_localize_clip
# WORKER_TASKS=

# NOTE: a remote worker only finds footage when VECTOR_STORE=zilliz (section 4).
# With the default in_memory store each process holds a private index.
